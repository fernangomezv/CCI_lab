# 12.3 PR curve: cancer history vs tooth loss (weighted PR model)
fit_pr_tooth_w <- svyglm(m9p_new_num ~ m5p_new, design = des_m, family = quasipoisson(link = "log"))
tt <- summary(fit_pr_tooth_w)$coefficients
beta <- tt["m5p_new", "Estimate"]; se_b <- tt["m5p_new", "Std. Error"]; pval <- tt["m5p_new", "Pr(>|t|)"]

pr1 <- exp(beta); pr1_l <- exp(beta - 1.96*se_b); pr1_u <- exp(beta + 1.96*se_b)
pr5 <- exp(5*beta); pr5_l <- exp(5*(beta - 1.96*se_b)); pr5_u <- exp(5*(beta + 1.96*se_b))

subtitle_w <- paste0(
  "β = ", round(beta, 3), " (SE ", round(se_b, 3), "), p = ", signif(pval, 3),
  " | PR per 1 tooth = ", round(pr1, 2), " [", round(pr1_l, 2), "–", round(pr1_u, 2), "]",
  " | PR per 5 teeth = ", round(pr5, 2), " [", round(pr5_l, 2), "–", round(pr5_u, 2), "]"
)

x_seq <- seq(min(des_m$variables$m5p_new, na.rm=TRUE), max(des_m$variables$m5p_new, na.rm=TRUE), by = 1)
Fig20 <- plot_pr_curve(beta = coef(fit_pr_tooth_w),
                       V = vcov(fit_pr_tooth_w),
                       x_seq = x_seq,
                       baseline_x = min(x_seq),
                       title = "Survey-weighted PR vs tooth loss",
                       subtitle = subtitle_w)
save_plot(Fig20, "Fig20_PR_curve_toothloss_weighted.png")

# 12.4 PR curve: unweighted PR (Poisson robust)
df_unw <- dat_m %>%
  select(m9p_new_num, m5p_new) %>%
  filter(!is.na(m9p_new_num), !is.na(m5p_new))

fit_pr_tooth_u <- glm(m9p_new_num ~ m5p_new, data = df_unw, family = poisson(link = "log"))
Vrob <- sandwich::vcovHC(fit_pr_tooth_u, type = "HC1")
ct <- lmtest::coeftest(fit_pr_tooth_u, vcov. = Vrob)

beta_u <- ct["m5p_new","Estimate"]; se_u <- ct["m5p_new","Std. Error"]; p_u <- ct["m5p_new","Pr(>|z|)"]
pr1_u_ <- exp(beta_u); pr1_l_ <- exp(beta_u - 1.96*se_u); pr1_h_ <- exp(beta_u + 1.96*se_u)

subtitle_u <- paste0(
  "β = ", round(beta_u, 3), " (robust SE ", round(se_u, 3), "), p = ", signif(p_u, 3),
  " | PR per 1 tooth = ", round(pr1_u_, 2), " [", round(pr1_l_, 2), "–", round(pr1_h_, 2), "]"
)

Fig21 <- plot_pr_curve(beta = coef(fit_pr_tooth_u),
                       V = Vrob,
                       x_seq = seq(min(df_unw$m5p_new), max(df_unw$m5p_new), by = 1),
                       baseline_x = min(df_unw$m5p_new),
                       title = "Unweighted PR vs tooth loss (Poisson robust)",
                       subtitle = subtitle_u)
save_plot(Fig21, "Fig21_PR_curve_toothloss_unweighted.png")


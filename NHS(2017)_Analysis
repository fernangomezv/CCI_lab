tidy_pr <- function(fit, model_name) {
  broom::tidy(fit) %>%
    mutate(
      model = model_name,
      PR = exp(estimate),
      PR_low = exp(estimate - 1.96*std.error),
      PR_high = exp(estimate + 1.96*std.error)
    ) %>%
    filter(term != "(Intercept)") %>%
    select(model, term, PR, PR_low, PR_high, p.value)
}


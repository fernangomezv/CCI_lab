#V. HELPERS
na_if_codes <- function(x, codes = c(-8888, 97, 98, 99, 997, 998, 999)) {
  if (is.character(x)) return(x)
  x <- as.numeric(x)
  x[x %in% codes] <- NA
  x
}

zscore <- function(x) {
  x <- as.numeric(x)
  m <- mean(x, na.rm = TRUE)
  s <- sd(x, na.rm = TRUE)
  if (is.na(s) || s == 0) return(rep(NA_real_, length(x)))
  (x - m) / s
}

save_plot <- function(p, filename, width = 7, height = 5, dpi = 300) {
  ggsave(filename = file.path(FIG_DIR, filename), plot = p,
         width = width, height = height, dpi = dpi)
}

# Detect binary-like variables (0/1, Yes/No)
is_binary_like <- function(x) {
  xx <- x[!is.na(x)]
  if (length(xx) == 0) return(FALSE)
  if (is.logical(xx)) return(TRUE)
  if (is.numeric(xx) || is.integer(xx)) return(all(unique(xx) %in% c(0, 1)))
  if (is.factor(xx) || is.character(xx)) {
    u <- unique(as.character(xx))
    return(all(u %in% c("No","Yes","0","1")))
  }
  FALSE
}

# Survey-weighted prevalence by group (svyby + CI)
weighted_prev_by <- function(des_svy, outcome_col, group_col) {
  f_y  <- as.formula(paste0("~", outcome_col))
  f_by <- as.formula(paste0("~", group_col))
  
  res <- survey::svyby(
    formula = f_y,
    by      = f_by,
    design  = des_svy,
    FUN     = survey::svymean,
    na.rm   = TRUE,
    vartype = c("ci"),
    drop.empty.groups = FALSE
  ) %>% as.data.frame()
  
  ci_l_col <- grep("ci_l", names(res), value = TRUE)[1]
  ci_u_col <- grep("ci_u", names(res), value = TRUE)[1]
  
  out <- res %>%
    transmute(
      group    = .data[[group_col]],
      prev     = .data[[outcome_col]],
      prev_low = .data[[ci_l_col]],
      prev_upp = .data[[ci_u_col]]
    )
  
  dat_vars <- as.data.frame(des_svy$variables)
  n_unw <- dat_vars %>%
    filter(!is.na(.data[[group_col]])) %>%
    count(.data[[group_col]], name = "n_unw") %>%
    rename(group = .data[[group_col]])
  
  out %>% left_join(n_unw, by = "group")
}

# Survey-adjusted chi-square p-value for 2-way table
svy_chisq_p <- function(des_svy, outcome_col, group_col) {
  f <- as.formula(paste0("~", outcome_col, " + ", group_col))
  
  des_tmp <- des_svy
  y <- des_tmp$variables[[outcome_col]]
  des_tmp$variables[[outcome_col]] <- factor(y, levels = c(0,1), labels = c("No","Yes"))
  
  tryCatch({
    test <- survey::svychisq(f, design = des_tmp, statistic = "F")
    as.numeric(test$p.value)
  }, error = function(e) {
    warning("svychisq failed: ", conditionMessage(e))
    NA_real_
  })
}

plot_weighted_prev <- function(prev_df, title, p_value = NULL) {
  subtitle_txt <- if (!is.null(p_value) && is.finite(p_value)) {
    paste0("Survey-adjusted chi-square p = ", signif(p_value, 3))
  } else NULL
  
  ggplot(prev_df, aes(x = group, y = prev)) +
    geom_point() +
    geom_errorbar(aes(ymin = prev_low, ymax = prev_upp), width = 0.15) +
    scale_y_continuous(labels = function(x) paste0(round(100*x, 1), "%")) +
    labs(title = title, subtitle = subtitle_txt, x = NULL,
         y = "Weighted prevalence (95% CI)") +
    theme_minimal()
}

plot_svyglm_pr_forest <- function(model, title) {
  td <- broom::tidy(model, conf.int = TRUE) %>%
    filter(term != "(Intercept)") %>%
    mutate(
      PR = exp(estimate),
      PR_low = exp(conf.low),
      PR_high = exp(conf.high),
      term = fct_reorder(term, PR)
    )
  
  ggplot(td, aes(x = PR, y = term)) +
    geom_vline(xintercept = 1, linetype = "dashed") +
    geom_point() +
    geom_errorbarh(aes(xmin = PR_low, xmax = PR_high), height = 0.15) +
    labs(title = title, x = "Prevalence Ratio (PR) with 95% CI", y = NULL) +
    theme_minimal()
}

# PR curve vs tooth loss (weighted OR unweighted)
plot_pr_curve <- function(beta, V, x_seq, baseline_x = min(x_seq), title, subtitle = NULL) {
  grid <- data.frame(m5p_new = x_seq)
  X <- model.matrix(~ m5p_new, data = grid)
  
  eta <- as.numeric(X %*% beta)
  se  <- sqrt(diag(X %*% V %*% t(X)))
  
  # baseline at baseline_x (often 0)
  idx0 <- which.min(abs(grid$m5p_new - baseline_x))
  eta0 <- eta[idx0]
  
  grid <- grid %>%
    mutate(
      PR    = exp(eta - eta0),
      PR_lo = exp((eta - 1.96*se) - eta0),
      PR_hi = exp((eta + 1.96*se) - eta0)
    )
  
  ggplot(grid, aes(x = m5p_new, y = PR)) +
    geom_ribbon(aes(ymin = PR_lo, ymax = PR_hi), alpha = 0.2) +
    geom_line(linewidth = 1) +
    geom_hline(yintercept = 1, linetype = "dashed") +
    labs(title = title, subtitle = subtitle,
         x = "Teeth lost (m5p_new)", y = "PR (relative to baseline)") +
    theme_minimal()
}



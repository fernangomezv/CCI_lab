w_mean_se <- function(des_tbl, var) {
  des_tbl %>%
    group_by(group) %>%
    summarise(m = survey_mean(.data[[var]], na.rm = TRUE, vartype = "se")) %>%
    transmute(group, variable = var, level = NA_character_, mean = m, se = m_se)
}

w_prop_se <- function(des_tbl, var) {
  x <- des_tbl$variables[[var]]
  lvls <- sort(unique(x[!is.na(x)]))
  
  purrr::map_dfr(lvls, function(lvl) {
    des_tbl %>%
      group_by(group) %>%
      summarise(p = survey_mean(I(.data[[var]] == lvl), na.rm = TRUE, vartype = "se")) %>%
      transmute(group, variable = var, level = as.character(lvl), prop = p, se = p_se)
  })
}

